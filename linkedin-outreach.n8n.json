        "jsCode": "const DEMO=true;const d1=DEMO?2*60*1000:24*60*60*1000;const d2=DEMO?2*60*1000:24*60*60*1000;const wd=$now.weekday;const hr=$now.hour;if(!(wd>=1&&wd<=5&&hr>=9&&hr<17))return [];const FU1='just following up on my note - keen to hear your thoughts when you have a sec.';const FU2='last nudge from me - happy to share more whenever it is useful. Glad to be connected either way.';const now=Date.now();const out=[];for(const r of $input.all()){const j=r.json;const s=String(j.status||'').trim();const f=j.first_name||'there';if(s==='Accepted'){out.push({json:{profile_id:j.profile_id,action:'first',first_name:f}});}else if(s==='First Msg Sent'&&j.first_msg_at&&(now-Date.parse(j.first_msg_at)>=d1)){out.push({json:{profile_id:j.profile_id,action:'followup',chat_id:j.chat_id,text:'Hi '+f+', '+FU1,status_to_set:'Follow-up 1 Sent',ts_field:'fu1_at'}});}else if(s==='Follow-up 1 Sent'&&j.fu1_at&&(now-Date.parse(j.fu1_at)>=d2)){out.push({json:{profile_id:j.profile_id,action:'followup',chat_id:j.chat_id,text:'Hi '+f+', '+FU2,status_to_set:'Follow-up 2 Sent',ts_field:'fu2_at'}});}else if(s==='Follow-up 2 Sent'){out.push({json:{profile_id:j.profile_id,action:'done'}});}}return out;"
